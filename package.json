{
  "name": "beamerpoint",
  "private": true,
  "version": "0.1.3",
  "author": {
    "name": "Abolfazl Mohebbi, PhD (Professor in Mechanical and Biomedical Engineering, Polytechnique Montreal)",
    "email": "abolfazl.mohebbi@polymtl.ca"
  },
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/engine",
    "packages/app",
    "packages/desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @beamerpoint/app",
    "build": "npm run build -w @beamerpoint/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:engine": "playwright test",
    "typecheck": "tsc -b",
    "engine:install": "node node_modules/texlyre-busytex/scripts/cli.cjs download-assets ./packages/app/public/core",
    "desktop:dev": "npm run build && npm run start -w @beamerpoint/desktop",
    "desktop:dist": "npm run build && npm run dist -w @beamerpoint/desktop"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
