{
  "name": "beamerpoint",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/engine",
    "packages/app"
  ],
  "scripts": {
    "dev": "npm run dev -w @beamerpoint/app",
    "build": "npm run build -w @beamerpoint/app",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b",
    "engine:install": "node node_modules/texlyre-busytex/scripts/cli.cjs download-assets ./packages/app/public/core"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.2.7",
    "fast-check": "^4.1.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
